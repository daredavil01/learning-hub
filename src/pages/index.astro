---
// One page: the whole hub is a React island fed with the validated roadmap.
import App from '../components/App.tsx';
import { loadRoadmap } from '../lib/roadmap.ts';
import '../styles/organic.css';
import '../styles/hub.css';

const data = loadRoadmap();
const description = `${data.meta.name}: the ${data.meta.title}, a ${data.meta.days}-day learning plan with daily tasks, resources, projects and interview prep. Fork it on GitHub.`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.meta.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap" />
    <script is:inline>
      // Apply the saved (or system) theme before first paint.
      try {
        var t = localStorage.getItem('ai60-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <App client:only="react" data={data} />
    <noscript><p style="padding:24px">This hub needs JavaScript. The plan itself is in the GitHub repository.</p></noscript>
  </body>
</html>
